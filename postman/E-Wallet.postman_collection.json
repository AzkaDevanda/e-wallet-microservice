    {
      "name": "5. Payment (payment-service, lewat gateway)",
      "item": [
        {
          "name": "Pay - buat sesi pending",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('field spec ada', () => pm.expect(body).to.include.keys('transactionID', 'message', 'newBalance'));",
                  "pm.test('status pending, saldo belum dipotong', () => {",
                  "  pm.expect(body.status).to.eql('pending');",
                  "  pm.expect(body.expiresAt).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('paymentID', body.transactionID);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantID\": \"merchant-123\",\n  \"amount\": 50000,\n  \"description\": \"Coffee and croissant\"\n}"
            },
            "url": { "raw": "{{paymentBaseUrl}}/transactions/pay", "host": ["{{paymentBaseUrl}}"], "path": ["transactions", "pay"] }
          }
        },
        {
          "name": "Pay - confirm (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('field spec ada', () => pm.expect(body).to.include.keys('transactionID', 'message', 'newBalance'));",
                  "pm.test('status completed', () => pm.expect(body.status).to.eql('completed'));",
                  "pm.test('ID sama dengan payment yang dibuat', () => pm.expect(body.transactionID).to.eql(pm.collectionVariables.get('paymentID')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{paymentBaseUrl}}/transactions/pay/{{paymentID}}/confirm",
              "host": ["{{paymentBaseUrl}}"],
              "path": ["transactions", "pay", "{{paymentID}}", "confirm"]
            }
          }
        },
        {
          "name": "Pay - confirm kedua kali (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('pesan sudah completed', () => pm.expect(pm.response.json().error).to.eql('payment is already completed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{paymentBaseUrl}}/transactions/pay/{{paymentID}}/confirm",
              "host": ["{{paymentBaseUrl}}"],
              "path": ["transactions", "pay", "{{paymentID}}", "confirm"]
            }
          }
        },
        {
          "name": "Pay - saldo tidak cukup (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantID\": \"merchant-123\",\n  \"amount\": 99999999\n}"
            },
            "url": { "raw": "{{paymentBaseUrl}}/transactions/pay", "host": ["{{paymentBaseUrl}}"], "path": ["transactions", "pay"] }
          }
        },
        {
          "name": "Pay - confirm id acak (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{paymentBaseUrl}}/transactions/pay/{{$guid}}/confirm",
              "host": ["{{paymentBaseUrl}}"],
              "path": ["transactions", "pay", "{{$guid}}", "confirm"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Internal core-service (Step 12 & 14, langsung ke :8081, hanya mode go run)",
      "description": "Endpoint antar service. Dipanggil langsung ke core-service ({{coreUrl}}), BUKAN lewat {{baseUrl}}/gateway.\n\nSebelum menjalankan: isi variabel collection `internalApiKey` dengan nilai INTERNAL_API_KEY di core-service/.env.\nFolder ini memakai `noauth`: JWT user tidak dipakai di sini, yang dipakai header X-Internal-API-Key.\nJalankan setelah folder 2-4 (butuh {{userID}} yang sudah punya saldo).",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Internal balance - tanpa API key (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('code UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{coreUrl}}/internal/wallets/{{userID}}/balance",
              "host": [
                "{{coreUrl}}"
              ],
              "path": [
                "internal",
                "wallets",
                "{{userID}}",
                "balance"
              ]
            }
          }
        },
        {
          "name": "Internal balance - JWT user saja, tanpa key (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Token user yang valid tetap DITOLAK: endpoint internal hanya menerima API key service.",
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{coreUrl}}/internal/wallets/{{userID}}/balance",
              "host": [
                "{{coreUrl}}"
              ],
              "path": [
                "internal",
                "wallets",
                "{{userID}}",
                "balance"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Internal balance (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('field userID & balance', () => pm.expect(body).to.have.keys('userID', 'balance'));",
                  "pm.test('saldo cukup untuk debit 10000', () => pm.expect(body.balance).to.be.at.least(10000));",
                  "pm.collectionVariables.set('balanceBefore', body.balance);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-API-Key",
                "value": "{{internalApiKey}}"
              }
            ],
            "url": {
              "raw": "{{coreUrl}}/internal/wallets/{{userID}}/balance",
              "host": [
                "{{coreUrl}}"
              ],
              "path": [
                "internal",
                "wallets",
                "{{userID}}",
                "balance"
              ]
            }
          }
        },
        {
          "name": "Debit (200, replayed false)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
