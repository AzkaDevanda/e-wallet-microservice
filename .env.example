# Dipakai oleh `docker compose --profile app up` (salin ke .env lalu isi).
# Nilainya HARUS sama dengan core-service/.env dan payment-service/.env kalau kamu juga menjalankan `go run`.
JWT_SECRET=ganti_dengan_secret_kamu
INTERNAL_API_KEY=ganti_dengan_internal_key_kamu

# Opsional (default di docker-compose.yaml)
# TOKEN_TTL=24h
# CORE_HTTP_TIMEOUT=5s
# PAYMENT_TTL=10m
# PAYMENT_EXPIRY_INTERVAL=30s
# PAYMENT_RECONCILE_GRACE=1m
# GATEWAY_PORT=8080
# CORE_DB_PORT=5433
# PAYMENT_DB_PORT=5434
